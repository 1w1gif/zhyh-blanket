{
  "name": "inspiration-wall",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wall/web",
    "build": "npm run build --workspace @wall/web",
    "cfbuild": "node scripts/cfbuild.mjs",
    "cfdeploy": "wrangler pages deploy .vercel/output/static --project-name zhyh-blanket --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "vercel": "^47.0.4",
    "wrangler": "^4.144.0"
  }
}
